        contentWidth: tabs.width; contentHeight: 40
        flickableDirection: Flickable.HorizontalFlick; clip: true; boundsBehavior: Flickable.StopAtBounds
    Row {
        id: tabs
        spacing: 24; height: 40
        Repeater {
            model: root.emojiOnly ? [root.onlyLabel] : ["Emoji", "Figurinhas"].concat(root.packs.map(function(p) { return p.name; })).concat(["+"])
            Item {
                width: label.implicitWidth; height: 40
                Text { id: label; anchors.centerIn: parent; text: modelData; color: root.tab === index ? root.fg : root.muted; font.pixelSize: 15; font.family: "Roboto"; font.weight: Font.Medium }
                Rectangle { anchors.bottom: parent.bottom; width: parent.width; height: 3; radius: 2; color: root.accent; visible: root.tab === index }
                MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: root.tab = index }
            }
        }
    }
    }

    // emoji: the categories (their first emoji), then the grid
    Row {
        id: cats
        visible: root.tab === 0
        x: 12; y: 52; spacing: 2
        Repeater {
            model: root.categories
            Rectangle {
                width: 36; height: 32; radius: 8
                color: root.category === index ? root.hover : "transparent"
                Text { anchors.centerIn: parent; text: modelData.icon; font.pixelSize: 20; font.family: "Noto Color Emoji" }
                MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: { root.category = index; grid.positionViewAtBeginning(); } }
            }
        }
    }
    Text {
        visible: root.tab === 0
        x: 16; y: 92
        text: root.categories.length > root.category ? root.categories[root.category].name : ""
        color: root.muted; font.pixelSize: 13; font.family: "Roboto"
    }
    GridView {
        id: grid
        visible: root.tab === 0
        x: 8; y: 114; width: parent.width - 16; height: parent.height - 122
        clip: true
        cellWidth: 44; cellHeight: 44
        model: root.categories.length > root.category ? root.categories[root.category].list : []
        delegate: Rectangle {
            width: 44; height: 44; radius: 10
            color: hov.hovered ? root.hover : "transparent"
            Text { anchors.centerIn: parent; text: modelData; font.pixelSize: 28; font.family: "Noto Color Emoji" }
            HoverHandler { id: hov }
            MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: root.emoji(modelData) }
        }
    }
    // stickers
    Text {
        visible: root.tab >= 1 && root.tab !== root.storeTab && root.shown.length === 0
        anchors.centerIn: parent
        text: "Nenhuma figurinha ainda"
        color: root.muted; font.pixelSize: 14; font.family: "Roboto"
    }
    GridView {
        visible: root.tab >= 1 && root.tab !== root.storeTab
        x: 8; y: 56; width: parent.width - 16; height: parent.height - 64
        clip: true
        cellWidth: 104; cellHeight: 104
        model: root.shown
        delegate: Rectangle {
            width: 100; height: 100; radius: 10
            color: shov.hovered ? root.hover : "transparent"
            Image { anchors.fill: parent; anchors.margins: 6; source: modelData.src; fillMode: Image.PreserveAspectFit; asynchronous: true; sourceSize: Qt.size(176, 176) }
            HoverHandler { id: shov }
            MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: root.sticker(modelData.id) }
        }
    }
    // "+": WhatsApp's own sticker packs (its sticker store), each added as a pack of ours
    Text {
        visible: root.tab === root.storeTab && root.store.length === 0
        anchors.centerIn: parent
        text: "Carregando pacotes…"
        color: root.muted; font.pixelSize: 14; font.family: "Roboto"
    }
    GridView {
        visible: root.tab === root.storeTab
        x: 8; y: 56; width: parent.width - 16; height: parent.height - 64
        clip: true
        cellWidth: 132; cellHeight: 132
        model: root.store
        delegate: Rectangle {
            width: 128; height: 128; radius: 10
            color: thov.hovered ? root.hover : "transparent"
            Image { x: 24; y: 8; width: 80; height: 80; source: modelData.tray || ""; fillMode: Image.PreserveAspectFit; asynchronous: true }
            Text {
                x: 6; y: 94; width: 116; horizontalAlignment: Text.AlignHCenter; elide: Text.ElideRight; maximumLineCount: 2; wrapMode: Text.WordWrap
                text: modelData.name; color: root.fg; font.pixelSize: 12; font.family: "Roboto"
            }
            HoverHandler { id: thov }
            MouseArea { anchors.fill: parent; cursorShape: Qt.PointingHandCursor; onClicked: root.storePick(modelData.id, modelData.name) }
        }
    }
}
