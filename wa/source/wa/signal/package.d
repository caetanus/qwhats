/// The Signal protocol as WhatsApp (and whatsmeow, and libsignal) use it, receive side: take a
/// PreKeySignalMessage addressed to us, run the X3DH key agreement as the receiver, drive the
/// double ratchet forward to the message's counter, verify its MAC and decrypt it. The maths is
/// pinned to libsignal v0.2.2 (see tests/signal-recv-vectors.json, generated by core/cmd/signalvec).
///
/// What the sender did, mirrored here: a sending party ran X3DH to get a root/chain pair, then
/// immediately ratcheted once over our signed pre-key with a fresh ephemeral ("ratchet key"),
/// which rides in the SignalMessage. We reproduce that one ratchet step with the same DH inputs
/// (DH is symmetric), land on the identical chain key, and walk it to the message counter.
module wa.signal;

import wa.crypto : aesCbcDecrypt, hkdf, hmacSha256, sharedSecret;
import wa.device : Device, djbType, serializedKey;
import wa.proto : ProtoReader;

class SignalException : Exception {
    this(string msg, string file = __FILE__, size_t line = __LINE__) { super(msg, file, line); }
}

/// A message whose counter we already passed — a duplicate / redelivery (libsignal ErrOldCounter).
/// whatsmeow skips such an <enc> and still sends the normal receipt.
class OldCounterException : SignalException {
    this(string msg, string file = __FILE__, size_t line = __LINE__) { super(msg, file, line); }
}

enum ubyte currentVersion = (3 << 4) | 3;   // 0x33 — Signal message version 3 (what WhatsApp speaks)

/// Message keys derived from a chain key: AES-256-CBC key, HMAC key, and IV.
struct MessageKeys {
    ubyte[32] cipherKey;
    ubyte[32] macKey;
    ubyte[16] iv;
}

/// Strip Signal's DJB type byte from a 33-byte serialized public key, returning the 32 raw bytes.
ubyte[32] stripType(const(ubyte)[] serialized) {
    if (serialized.length == 33) {
        if (serialized[0] != djbType) throw new SignalException("bad public key type byte");
        return serialized[1 .. 33][0 .. 32];
    }
    if (serialized.length == 32) return serialized[0 .. 32];
    throw new SignalException("bad public key length");
}

/// The receiver X3DH agreement. Returns 64 bytes: root key (first 32) then chain key (last 32).
/// `oneTimePriv` is null when the sender used no one-time pre-key.
ubyte[64] x3dhReceiver(const ubyte[32] identityPriv, const ubyte[32] signedPreKeyPriv,
    const(ubyte)[] oneTimePriv, const ubyte[32] theirIdentityPub, const ubyte[32] theirBasePub) {
    ubyte[] master;
    master.length = 32;
    master[] = 0xFF;                                                       // the discontinuity block
    master ~= sharedSecret(signedPreKeyPriv, theirIdentityPub)[];          // DH1: their identity
    master ~= sharedSecret(identityPriv, theirBasePub)[];                  // DH2: their base
    master ~= sharedSecret(signedPreKeyPriv, theirBasePub)[];              // DH3: their base
    if (oneTimePriv !is null) {
        ubyte[32] ot = oneTimePriv[0 .. 32];
        master ~= sharedSecret(ot, theirBasePub)[];                        // DH4: their base, our one-time
    }
    auto derived = hkdf(master, null, cast(const(ubyte)[]) "WhisperText", 64);
    ubyte[64] r = derived[0 .. 64];
    return r;
}

/// The sender X3DH agreement. Returns 64 bytes: root key (first 32) then chain key (last 32). The
/// DH inputs mirror x3dhReceiver (DH is symmetric), so both sides land on the same master secret.
/// `oneTimePub` is null when no one-time pre-key is used.
ubyte[64] x3dhSender(const ubyte[32] identityPriv, const ubyte[32] basePriv,
    const ubyte[32] theirIdentityPub, const ubyte[32] theirSignedPreKeyPub, const(ubyte)[] oneTimePub) {
    import wa.crypto : sharedSecret, hkdf;
    ubyte[] master;
    master.length = 32;
    master[] = 0xFF;
    master ~= sharedSecret(identityPriv, theirSignedPreKeyPub)[];   // DH1
    master ~= sharedSecret(basePriv, theirIdentityPub)[];           // DH2
    master ~= sharedSecret(basePriv, theirSignedPreKeyPub)[];       // DH3
    if (oneTimePub !is null) {
        ubyte[32] ot = oneTimePub[0 .. 32];
        master ~= sharedSecret(basePriv, ot)[];                     // DH4
    }
    auto derived = hkdf(master, null, cast(const(ubyte)[]) "WhisperText", 64);
    ubyte[64] r = derived[0 .. 64];
    return r;
}

/// One root-key ratchet step: a fresh DH over the peer's ratchet key, folded into the root key.
/// Returns the new root key (first 32) and the chain key for this ratchet (last 32).
ubyte[64] rootRatchet(const ubyte[32] rootKey, const ubyte[32] theirRatchetPub, const ubyte[32] ourRatchetPriv) {
    const ss = sharedSecret(ourRatchetPriv, theirRatchetPub);
    auto derived = hkdf(ss[], rootKey[], cast(const(ubyte)[]) "WhisperRatchet", 64);
    ubyte[64] r = derived[0 .. 64];
    return r;
}

/// Ratchet a chain key forward one step: chainKey' = HMAC(chainKey, 0x02).
ubyte[32] nextChainKey(const ubyte[32] chainKey) {
    const ubyte[1] seed = [0x02];
    return hmacSha256(chainKey[], seed[]);
}

/// The message keys for the current chain key: HKDF over HMAC(chainKey, 0x01).
MessageKeys messageKeys(const ubyte[32] chainKey) {
    const ubyte[1] seed = [0x01];
    const base = hmacSha256(chainKey[], seed[]);
    auto km = hkdf(base[], null, cast(const(ubyte)[]) "WhisperMessageKeys", 80);
    MessageKeys k;
    k.cipherKey = km[0 .. 32];
    k.macKey = km[32 .. 64];
    k.iv = km[64 .. 80];
    return k;
}

/// A parsed SignalMessage: the sender's ratchet key, the counter, the ciphertext, and — kept apart —
/// the bytes the MAC is taken over (version byte ‖ protobuf, without the trailing 8-byte MAC).
struct SignalMessage {
    ubyte[32] ratchetKey;
    uint counter;
    uint previousCounter;
    ubyte[] ciphertext;
    ubyte[8] mac;
    ubyte[] macBase;        // version byte ‖ protobuf body (what getMac hashes after the identities)
}

/// Parse a serialized SignalMessage (version byte ‖ protobuf ‖ 8-byte MAC).
SignalMessage parseSignalMessage(const(ubyte)[] wire) {
    if (wire.length < 1 + 8) throw new SignalException("signal message too short");
    if (wire[0] != currentVersion) throw new SignalException("unsupported signal message version");
    SignalMessage m;
    m.macBase = wire[0 .. $ - 8].dup;
    m.mac = wire[$ - 8 .. $][0 .. 8];
    auto body = wire[1 .. $ - 8];
    auto r = ProtoReader(body);
    m.ratchetKey = stripType(r.get(1).bytes);
    m.counter = cast(uint) r.get(2).value;
    m.previousCounter = cast(uint) r.get(3).value;
    m.ciphertext = r.get(4).bytes.dup;
    if (m.ciphertext.length == 0) throw new SignalException("signal message has no ciphertext");
    return m;
}

/// A parsed PreKeySignalMessage: the sender's base and identity keys, the pre-key ids used, and the
/// inner SignalMessage bytes.
struct PreKeySignalMessage {
    uint preKeyId;
    bool hasPreKeyId;
    uint signedPreKeyId;
    uint registrationId;
    ubyte[32] baseKey;
    ubyte[32] identityKey;      // the sender's identity public key
    ubyte[] message;            // the inner SignalMessage (its own version byte ‖ protobuf ‖ MAC)
}

/// Parse a serialized PreKeySignalMessage (version byte ‖ protobuf).
PreKeySignalMessage parsePreKeyMessage(const(ubyte)[] wire) {
    if (wire.length < 1) throw new SignalException("prekey message empty");
    if (wire[0] != currentVersion) throw new SignalException("unsupported prekey message version");
    PreKeySignalMessage m;
    auto r = ProtoReader(wire[1 .. $]);
    if (r.has(1)) { m.preKeyId = cast(uint) r.get(1).value; m.hasPreKeyId = true; }
    m.baseKey = stripType(r.get(2).bytes);
    m.identityKey = stripType(r.get(3).bytes);
    m.message = r.get(4).bytes.dup;
    m.registrationId = cast(uint) r.get(5).value;
    m.signedPreKeyId = cast(uint) r.get(6).value;
    if (m.message.length == 0) throw new SignalException("prekey message has no inner message");
    return m;
}

/// Decrypt a PreKeySignalMessage addressed to us. `oneTimePriv` is the private half of the one-time
/// pre-key the sender named (null if `pk.hasPreKeyId` is false). Throws on a MAC mismatch or any
/// malformed input. The returned bytes are the Signal plaintext (for real WhatsApp traffic this is a
/// padded Message protobuf; unpadding is a separate, higher layer).
ubyte[] decryptPreKeyMessage(ref const Device dev, const ref PreKeySignalMessage pk,
    const(ubyte)[] oneTimePriv) {
    auto sm = parseSignalMessage(pk.message);

    const rc = x3dhReceiver(dev.identityKey.priv, dev.signedPreKey.key.priv, oneTimePriv,
        pk.identityKey, pk.baseKey);
    ubyte[32] rootKey = rc[0 .. 32];

    // one ratchet step over the sender's ratchet key, our signed pre-key as the receiving ratchet
    const rr = rootRatchet(rootKey, sm.ratchetKey, dev.signedPreKey.key.priv);
    ubyte[32] chainKey = rr[32 .. 64];

    foreach (_; 0 .. sm.counter) chainKey = nextChainKey(chainKey);
    const keys = messageKeys(chainKey);

    // MAC: HMAC(macKey, serialized(senderIdentity) ‖ serialized(ourIdentity) ‖ macBase)[0..8]
    ubyte[] macInput = serializedKey(pk.identityKey) ~ serializedKey(dev.identityKey.pub) ~ sm.macBase;
    const full = hmacSha256(keys.macKey[], macInput);
    if (full[0 .. 8] != sm.mac[]) throw new SignalException("signal message MAC mismatch");

    return aesCbcDecrypt(keys.cipherKey[], keys.iv[], sm.ciphertext);
}

version (unittest) import std.json, std.file, std.path, std.conv;

unittest {
    // Replay libsignal's own output: load Bob's keys, decrypt the three PreKeySignalMessages Alice
    // sent through a real SessionCipher, and check we recover the exact plaintexts.
    static ubyte[32] k32(string hex) {
        ubyte[32] o;
        foreach (i; 0 .. 32) o[i] = cast(ubyte) hex[2 * i .. 2 * i + 2].to!ubyte(16);
        return o;
    }
    const path = buildPath(__FILE_FULL_PATH__.dirName, "..", "..", "..", "tests", "signal-recv-vectors.json");
    if (!exists(path)) return;   // vectors not generated in this checkout — skip
    auto v = parseJSON(readText(path));

    Device dev;
    dev.identityKey.priv = k32(v["bobIdentityPriv"].str);
    dev.identityKey.pub = k32(v["bobIdentityPub"].str);
    dev.signedPreKey.key.priv = k32(v["bobSignedPreKeyPriv"].str);
    dev.signedPreKey.key.pub = k32(v["bobSignedPreKeyPub"].str);
    dev.signedPreKey.id = cast(uint) v["bobSignedPreKeyId"].integer;
    const oneTimePriv = k32(v["bobPreKeyPriv"].str);

    foreach (m; v["messages"].array) {
        assert(m["type"].integer == 3, "expected PreKeySignalMessage");
        auto wire = new ubyte[m["serialized"].str.length / 2];
        foreach (i; 0 .. wire.length)
            wire[i] = cast(ubyte) m["serialized"].str[2 * i .. 2 * i + 2].to!ubyte(16);
        auto pk = parsePreKeyMessage(wire);
        auto plain = decryptPreKeyMessage(dev, pk, pk.hasPreKeyId ? oneTimePriv[] : null);
        assert(cast(string) plain == m["plaintext"].str,
            "decrypted \"" ~ cast(string) plain ~ "\" != \"" ~ m["plaintext"].str ~ "\"");
    }
}
